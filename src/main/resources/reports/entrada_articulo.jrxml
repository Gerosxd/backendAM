<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="entrada_articulo"
              pageWidth="595"
              pageHeight="842"
              orientation="Portrait"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="14"
              bottomMargin="14"
              whenNoDataType="AllSectionsNoDetail">

    <parameter name="P_FOLIO" class="java.lang.String"/>
    <parameter name="P_FECHA" class="java.lang.String"/>
    <parameter name="P_PROVEEDOR" class="java.lang.String"/>
    <parameter name="P_OBSERVACIONES" class="java.lang.String"/>
    <parameter name="P_DEPARTAMENTO" class="java.lang.String"/>
    <parameter name="P_LOGO_PATH" class="java.lang.String"/>

    <field name="item" class="java.lang.Integer"/>
    <field name="cantidad" class="java.lang.Integer"/>
    <field name="descripcion" class="java.lang.String"/>
    <field name="numeroParte" class="java.lang.String"/>
    <field name="numeroSerie" class="java.lang.String"/>
    <field name="condicion" class="java.lang.String"/>
    <field name="proveedor" class="java.lang.String"/>
    <field name="observaciones" class="java.lang.String"/>

    <title>
        <band height="150">

            <!-- marco general -->
            <rectangle>
                <reportElement x="0" y="0" width="555" height="150"/>
                <graphicElement>
                    <pen lineWidth="0.7"/>
                </graphicElement>
            </rectangle>

            <!-- logo -->
            <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle">
                <reportElement x="6" y="6" width="90" height="78"/>
                <imageExpression><![CDATA[$P{P_LOGO_PATH}]]></imageExpression>
            </image>

            <!-- bloque azul título -->
            <rectangle>
                <reportElement x="96" y="0" width="321" height="78" backcolor="#0A88AE" mode="Opaque"/>
                <graphicElement>
                    <pen lineWidth="0.7"/>
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement x="96" y="0" width="321" height="78"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[ENTRADA DE ALMACÉN.]]></text>
            </staticText>

            <!-- bloque derecho empresa -->
            <staticText>
                <reportElement x="417" y="10" width="138" height="55"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[AG AVIATION SUPPLIERS S.A DE C.V.
TALLER AERONAUTICO AUTORIZADO
A.F.A.C NO. 505.]]></text>
            </staticText>

            <!-- línea -->
            <line>
                <reportElement x="0" y="78" width="555" height="1"/>
            </line>

            <!-- fecha -->
            <staticText>
                <reportElement x="0" y="82" width="36" height="16"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Fecha:]]></text>
            </staticText>

            <textField isBlankWhenNull="true">
                <reportElement x="36" y="82" width="54" height="16"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_FECHA}]]></textFieldExpression>
            </textField>

            <!-- proveedor -->
            <staticText>
                <reportElement x="90" y="82" width="58" height="16"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Proveedor:]]></text>
            </staticText>

            <textField isBlankWhenNull="true">
                <reportElement x="148" y="82" width="329" height="16"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_PROVEEDOR}]]></textFieldExpression>
            </textField>

            <!-- folio -->
            <rectangle>
                <reportElement x="477" y="78" width="78" height="20" backcolor="#59B7E2" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.7"/></graphicElement>
            </rectangle>

            <staticText>
                <reportElement x="481" y="82" width="28" height="12"/>
                <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[FOLIO:]]></text>
            </staticText>

            <textField isBlankWhenNull="true">
                <reportElement x="509" y="82" width="42" height="12"/>
                <textElement verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_FOLIO}]]></textFieldExpression>
            </textField>

            <!-- observaciones -->
            <staticText>
                <reportElement x="0" y="108" width="72" height="15"/>
                <textElement verticalAlignment="Top"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Observaciones:]]></text>
            </staticText>

            <!-- departamento -->
            <staticText>
                <reportElement x="395" y="108" width="82" height="15"/>
                <textElement verticalAlignment="Top"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Departamento:]]></text>
            </staticText>

            <textField isBlankWhenNull="true">
                <reportElement x="477" y="108" width="78" height="15"/>
                <textElement verticalAlignment="Top"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Almacén."]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="18">
            <staticText><reportElement x="0" y="0" width="28" height="18" backcolor="#0A88AE" mode="Opaque"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[ITEM]]></text></staticText>
            <staticText><reportElement x="28" y="0" width="35" height="18" backcolor="#0A88AE" mode="Opaque"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[QTY]]></text></staticText>
            <staticText><reportElement x="63" y="0" width="159" height="18" backcolor="#0A88AE" mode="Opaque"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[DESCRIPCIÓN]]></text></staticText>
            <staticText><reportElement x="222" y="0" width="113" height="18" backcolor="#0A88AE" mode="Opaque"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[NUMERO DE PARTE]]></text></staticText>
            <staticText><reportElement x="335" y="0" width="105" height="18" backcolor="#0A88AE" mode="Opaque"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[NUMERO DE SERIE]]></text></staticText>
            <staticText><reportElement x="440" y="0" width="78" height="18" backcolor="#0A88AE" mode="Opaque"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[CONDICIÓN]]></text></staticText>
            <staticText><reportElement x="518" y="0" width="0" height="0"/></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="10" splitType="Prevent">
            <textField isBlankWhenNull="true"><reportElement x="0" y="0" width="28" height="10"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{item}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="28" y="0" width="35" height="10"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="63" y="0" width="159" height="10"/><box><pen lineWidth="0.5"/></box><textElement verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{descripcion}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="222" y="0" width="113" height="10"/><box><pen lineWidth="0.5"/></box><textElement verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{numeroParte}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="335" y="0" width="105" height="10"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{numeroSerie}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="440" y="0" width="78" height="10"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{condicion}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="518" y="0" width="37" height="10"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{proveedor}]]></textFieldExpression></textField>
        </band>
    </detail>

    <summary>
        <band height="130">

            <!-- nota -->
            <rectangle>
                <reportElement x="0" y="0" width="555" height="20" backcolor="#0A88AE" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </rectangle>

            <staticText>
                <reportElement x="4" y="3" width="547" height="14"/>
                <textElement verticalAlignment="Middle">
                    <font size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[* NOTA: LA CONDICIÓN SE DEFINE POR: NUEVO DE FABRICA (NF), NEW SURPLUS (NS), OVERHAULED (OH), REMOVIDO (AR), SERVICIABLE (SV), REPARABLE (RP), CALIBRADO (CA).]]></text>
            </staticText>

            <!-- títulos firmas -->
            <staticText>
                <reportElement x="25" y="45" width="160" height="18"/>
                <textElement textAlignment="Center"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[ENCARGADO DE ALMACEN:]]></text>
            </staticText>

            <staticText>
                <reportElement x="198" y="45" width="160" height="18"/>
                <textElement textAlignment="Center"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[TRASLADA:]]></text>
            </staticText>

            <staticText>
                <reportElement x="371" y="45" width="160" height="18"/>
                <textElement textAlignment="Center"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[RECIBE:]]></text>
            </staticText>

            <!-- nombres/firma -->
            <staticText>
                <reportElement x="15" y="82" width="72" height="12"/>
                <textElement><font size="8" isBold="true"/></textElement>
                <text><![CDATA[NOMBRE/FIRMA:]]></text>
            </staticText>

            <line><reportElement x="87" y="94" width="105" height="1"/></line>

            <staticText>
                <reportElement x="15" y="102" width="40" height="12"/>
                <textElement><font size="8" isBold="true"/></textElement>
                <text><![CDATA[FECHA:]]></text>
            </staticText>

            <line><reportElement x="55" y="114" width="65" height="1"/></line>

            <staticText>
                <reportElement x="198" y="82" width="72" height="12"/>
                <textElement><font size="8" isBold="true"/></textElement>
                <text><![CDATA[NOMBRE/FIRMA:]]></text>
            </staticText>

            <line><reportElement x="270" y="94" width="105" height="1"/></line>

            <staticText>
                <reportElement x="198" y="102" width="40" height="12"/>
                <textElement><font size="8" isBold="true"/></textElement>
                <text><![CDATA[FECHA:]]></text>
            </staticText>

            <line><reportElement x="238" y="114" width="65" height="1"/></line>

            <staticText>
                <reportElement x="381" y="82" width="72" height="12"/>
                <textElement><font size="8" isBold="true"/></textElement>
                <text><![CDATA[NOMBRE/FIRMA:]]></text>
            </staticText>

            <line><reportElement x="453" y="94" width="90" height="1"/></line>

            <staticText>
                <reportElement x="381" y="102" width="40" height="12"/>
                <textElement><font size="8" isBold="true"/></textElement>
                <text><![CDATA[FECHA:]]></text>
            </staticText>

            <line><reportElement x="421" y="114" width="65" height="1"/></line>

        </band>
    </summary>
</jasperReport>